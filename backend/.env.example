# Only needed when running the backend OUTSIDE docker-compose (e.g. ./gradlew bootRun).
# Copy to .env, fill in values, then load into your shell before running, e.g.:
#   set -a; source .env; set +a; ./gradlew bootRun
# When running via `docker compose up`, the root-level .env is used instead.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=travelroute
DB_USERNAME=travelroute
DB_PASSWORD=changeme

KAKAO_REST_API_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:5173
