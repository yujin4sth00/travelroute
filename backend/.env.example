# Only needed when running the backend OUTSIDE docker-compose (e.g. ./gradlew bootRun).
# Copy to .env, fill in values, then load into your shell before running, e.g.:
#   set -a; source .env; set +a; ./gradlew bootRun
# When running via `docker compose up`, the root-level .env is used instead.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=travelroute
DB_USERNAME=travelroute
DB_PASSWORD=changeme

KAKAO_REST_API_KEY=
# Kakao Developers 콘솔 > 카카오 로그인 > Redirect URI에 등록해야 하는 값과 동일해야 함
KAKAO_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/kakao/callback

CORS_ALLOWED_ORIGINS=http://localhost:5173

# 로그인 성공 후 사용자를 돌려보낼 프론트엔드 주소
FRONTEND_BASE_URL=http://localhost:5173

# JWT 서명 키. HS256 사용 시 최소 32자 이상 필요 (openssl rand -base64 32 등으로 생성)
JWT_SECRET=
# 초 단위, 기본 7일
JWT_EXPIRATION_SECONDS=604800
